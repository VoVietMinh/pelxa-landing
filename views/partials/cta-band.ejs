<section class="py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[28px] bg-future-gradient text-white px-8 py-14 sm:px-14 sm:py-16 shadow-pelxa">
      <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-white/10 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-20 w-80 h-80 rounded-full bg-cyan-spark/20 blur-3xl"></div>
      <div class="relative grid md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2">
          <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-display font-bold tracking-[-0.02em]">
            <%= cta.title %>
          </h2>
          <p class="mt-4 text-white/80 text-lg max-w-2xl"><%= cta.subtitle %></p>
        </div>
        <div class="flex flex-col sm:flex-row md:flex-col gap-3 md:items-end">
          <a href="<%= t.brand.ctaPrimaryUrl %>" target="_blank" rel="noopener" class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-white text-pelxa-blue font-semibold shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all">
            <%= cta.primary %>
            <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="<%= pathFor('contact') %>" class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl border border-white/30 text-white font-semibold hover:bg-white/10 transition-colors">
            <%= cta.secondary %>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
