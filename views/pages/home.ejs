<!-- HERO -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-frost via-white to-white"></div>
  <div class="absolute -top-40 -right-40 w-[36rem] h-[36rem] rounded-full bg-pelxa-blue/15 blur-3xl"></div>
  <div class="absolute -top-32 -left-40 w-[26rem] h-[26rem] rounded-full bg-cyan-spark/15 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 pb-24 lg:pt-28 lg:pb-32">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ice-blue text-pelxa-blue text-xs font-semibold tracking-wide uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-pelxa-blue animate-pulse"></span>
          <%= t.home.hero.eyebrow %>
        </span>
        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-[64px] lg:leading-[1.05] font-display font-extrabold text-navy tracking-[-0.02em]">
          <%= t.home.hero.title %>
        </h1>
        <p class="mt-6 text-lg text-slate-700 max-w-2xl leading-relaxed">
          <%= t.home.hero.subtitle %>
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="<%= t.brand.ctaPrimaryUrl %>" target="_blank" rel="noopener" class="btn-primary">
            <%= t.home.hero.primary %>
            <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="<%= pathFor('solutions') %>" class="btn-secondary">
            <%= t.home.hero.secondary %>
          </a>
        </div>

        <dl class="mt-12 grid grid-cols-3 gap-6 max-w-xl">
          <% t.home.hero.stats.forEach(function(s){ %>
            <div>
              <dt class="text-2xl sm:text-3xl font-extrabold text-pelxa-blue tracking-tight"><%= s.value %></dt>
              <dd class="text-xs sm:text-sm text-cool-gray mt-1"><%= s.label %></dd>
            </div>
          <% }); %>
        </dl>
      </div>

      <div class="lg:col-span-5">
        <div class="relative">
          <div class="absolute inset-0 bg-future-gradient rounded-[32px] rotate-3 opacity-20 blur-2xl"></div>
          <div class="relative rounded-[28px] bg-white p-7 shadow-pelxa border border-soft-border">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <img src="/assets/logo-icon.svg" alt="" class="w-9 h-9 rounded-xl" aria-hidden="true" />
                <div>
                  <p class="text-sm font-semibold text-navy">Pelxa Console</p>
                  <p class="text-xs text-cool-gray">Performance — last 30 days</p>
                </div>
              </div>
              <span class="px-2 py-1 rounded-md bg-success/10 text-success text-xs font-semibold">+38.4%</span>
            </div>

            <div class="mt-6 space-y-4">
              <div class="flex items-center justify-between p-4 rounded-2xl border border-soft-border bg-frost">
                <div class="flex items-center gap-3">
                  <img src="/assets/icons/content.svg" alt="" class="w-9 h-9" aria-hidden="true" />
                  <div>
                    <p class="text-sm font-semibold text-navy">Content channels</p>
                    <p class="text-xs text-cool-gray">42 active · 8 markets</p>
                  </div>
                </div>
                <span class="text-sm font-semibold text-pelxa-blue">+12.6%</span>
              </div>
              <div class="flex items-center justify-between p-4 rounded-2xl border border-soft-border bg-white">
                <div class="flex items-center gap-3">
                  <img src="/assets/icons/traffic.svg" alt="" class="w-9 h-9" aria-hidden="true" />
                  <div>
                    <p class="text-sm font-semibold text-navy">Traffic sources</p>
                    <p class="text-xs text-cool-gray">156k sessions today</p>
                  </div>
                </div>
                <span class="text-sm font-semibold text-pelxa-blue">+24.1%</span>
              </div>
              <div class="flex items-center justify-between p-4 rounded-2xl border border-soft-border bg-frost">
                <div class="flex items-center gap-3">
                  <img src="/assets/icons/ads.svg" alt="" class="w-9 h-9" aria-hidden="true" />
                  <div>
                    <p class="text-sm font-semibold text-navy">RPM optimization</p>
                    <p class="text-xs text-cool-gray">$8.42 → $11.62</p>
                  </div>
                </div>
                <span class="text-sm font-semibold text-pelxa-blue">+38.0%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<section class="py-12 border-y border-soft-border/60 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="text-center text-sm font-medium text-cool-gray"><%= t.home.trust.title %></p>
    <ul class="mt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-8 gap-y-4 items-center">
      <% t.home.trust.items.forEach(function(name){ %>
        <li class="text-center text-sm font-semibold text-cool-gray/80 tracking-wide uppercase"><%= name %></li>
      <% }); %>
    </ul>
  </div>
</section>

<!-- PILLARS -->
<section class="py-20 lg:py-28 bg-gradient-to-b from-white to-frost">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="eyebrow"><%= t.home.pillars.eyebrow %></span>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-navy tracking-[-0.02em]">
        <%= t.home.pillars.title %>
      </h2>
      <p class="mt-5 text-lg text-slate-700 leading-relaxed">
        <%= t.home.pillars.subtitle %>
      </p>
    </div>

    <div class="mt-14 grid md:grid-cols-3 gap-6">
      <% t.home.pillars.items.forEach(function(p){ %>
        <article class="card group">
          <div class="w-14 h-14 rounded-2xl bg-ice-blue flex items-center justify-center">
            <img src="/assets/icons/<%= p.icon %>.svg" alt="" class="w-9 h-9" aria-hidden="true" />
          </div>
          <h3 class="mt-6 text-xl font-bold text-navy"><%= p.title %></h3>
          <p class="mt-3 text-slate-700 leading-relaxed"><%= p.description %></p>
          <ul class="mt-5 space-y-2">
            <% p.bullets.forEach(function(b){ %>
              <li class="flex items-start gap-2 text-sm text-slate-700">
                <svg class="w-4 h-4 mt-0.5 text-pelxa-blue flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <%= b %>
              </li>
            <% }); %>
          </ul>
          <a href="<%= pathFor('solutions') %>" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-pelxa-blue group-hover:gap-2.5 transition-all">
            <%= t.home.blog.viewAll %>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- WHY -->
<section class="py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="eyebrow"><%= t.home.why.eyebrow %></span>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-navy tracking-[-0.02em]">
        <%= t.home.why.title %>
      </h2>
    </div>
    <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% t.home.why.items.forEach(function(item){ %>
        <div class="card-soft">
          <img src="/assets/icons/<%= item.icon %>.svg" alt="" class="w-12 h-12" aria-hidden="true" />
          <h3 class="mt-5 text-lg font-bold text-navy"><%= item.title %></h3>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed"><%= item.description %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="py-20 lg:py-28 bg-frost">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="eyebrow"><%= t.home.howItWorks.eyebrow %></span>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-navy tracking-[-0.02em]">
        <%= t.home.howItWorks.title %>
      </h2>
    </div>
    <ol class="mt-14 grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      <% t.home.howItWorks.steps.forEach(function(s){ %>
        <li class="card relative">
          <span class="absolute top-6 right-6 text-5xl font-extrabold text-ice-blue tracking-tight"><%= s.step %></span>
          <h3 class="mt-2 text-lg font-bold text-navy max-w-[80%]"><%= s.title %></h3>
          <p class="mt-3 text-sm text-slate-700 leading-relaxed"><%= s.description %></p>
        </li>
      <% }); %>
    </ol>
  </div>
</section>

<!-- BLOG TEASER -->
<section class="py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="max-w-2xl">
        <span class="eyebrow"><%= t.home.blog.eyebrow %></span>
        <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-navy tracking-[-0.02em]">
          <%= t.home.blog.title %>
        </h2>
        <p class="mt-4 text-lg text-slate-700"><%= t.home.blog.subtitle %></p>
      </div>
      <a href="<%= pathFor('resources') %>" class="btn-secondary self-start md:self-end">
        <%= t.home.blog.viewAll %>
        <svg class="w-4 h-4 ml-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
    <div class="mt-12 grid md:grid-cols-3 gap-6">
      <% var slugBase = locale === 'vi' ? 'tai-nguyen' : 'resources'; %>
      <% recentPosts.forEach(function(p){ %>
        <article class="card group">
          <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-ice-blue text-pelxa-blue text-xs font-semibold uppercase tracking-wide"><%= p.category %></span>
          <h3 class="mt-4 text-lg font-bold text-navy leading-snug group-hover:text-pelxa-blue transition-colors">
            <a href="/<%= locale %>/<%= slugBase %>/<%= p.slug %>"><%= p.title %></a>
          </h3>
          <p class="mt-3 text-sm text-slate-700 leading-relaxed"><%= p.excerpt %></p>
          <div class="mt-5 flex items-center gap-4 text-xs text-cool-gray">
            <span><%= p.date %></span>
            <span>·</span>
            <span><%= p.readMinutes %> <%= t.resources.labels.readMinutes %></span>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- CTA BAND -->
<%- include('../partials/cta-band', { cta: t.home.ctaBand }) %>
