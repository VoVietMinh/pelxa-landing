<%- include('../partials/page-hero', { hero: t.about.hero }) %>

<section class="py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-7">
      <h2 class="text-3xl sm:text-4xl font-display font-bold text-navy tracking-[-0.02em]"><%= t.about.story.title %></h2>
      <div class="mt-6 space-y-5">
        <% t.about.story.paragraphs.forEach(function(p){ %>
          <p class="text-lg text-slate-700 leading-relaxed"><%= p %></p>
        <% }); %>
      </div>
    </div>
    <div class="lg:col-span-5">
      <div class="relative">
        <div class="absolute inset-0 bg-future-gradient rounded-[28px] rotate-2 opacity-15 blur-2xl"></div>
        <div class="relative card-feature">
          <h3 class="text-sm font-semibold text-cool-gray uppercase tracking-wide"><%= t.about.values.title %></h3>
          <ul class="mt-5 grid grid-cols-2 gap-4">
            <% t.about.values.items.forEach(function(v){ %>
              <li class="p-4 rounded-2xl bg-frost border border-soft-border">
                <p class="text-base font-bold text-pelxa-blue"><%= v.title %></p>
                <p class="mt-1.5 text-xs text-slate-700 leading-snug"><%= v.description %></p>
              </li>
            <% }); %>
          </ul>
          <div class="mt-6 flex items-center gap-3 p-4 rounded-2xl bg-pelxa-blue/[0.04] border border-pelxa-blue/15">
            <img src="/assets/logo-icon.svg" alt="" class="w-10 h-10 rounded-xl" aria-hidden="true" />
            <div>
              <p class="text-sm font-semibold text-navy">Pelxa</p>
              <p class="text-xs text-cool-gray"><%= t.brand.tagline %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/cta-band', { cta: t.about.ctaBand }) %>
