<section class="py-24 lg:py-32">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
    <img src="/assets/logo-icon.svg" alt="Pelxa" class="w-16 h-16 mx-auto rounded-2xl shadow-pelxa" />
    <h1 class="mt-8 text-5xl sm:text-6xl font-display font-extrabold text-navy tracking-[-0.02em]">500</h1>
    <h2 class="mt-3 text-2xl sm:text-3xl font-bold text-navy">Server error</h2>
    <p class="mt-4 text-lg text-slate-700">Something went wrong on our end.</p>
    <a href="/<%= locale %>" class="mt-8 inline-flex btn-primary"><%= t.notFound.back %></a>
  </div>
</section>
