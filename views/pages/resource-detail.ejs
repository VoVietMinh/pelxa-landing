<% var slugBase = locale === 'vi' ? 'tai-nguyen' : 'resources'; %>
<section class="bg-frost border-b border-soft-border/60">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <a href="<%= pathFor('resources') %>" class="inline-flex items-center gap-1.5 text-sm font-semibold text-pelxa-blue hover:gap-2.5 transition-all">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <%= t.resources.labels.back %>
    </a>
    <span class="mt-6 inline-flex items-center px-2.5 py-1 rounded-md bg-pelxa-blue/10 text-pelxa-blue text-xs font-semibold uppercase tracking-wide"><%= post.category %></span>
    <h1 class="mt-4 text-3xl sm:text-4xl lg:text-[48px] lg:leading-[1.1] font-display font-extrabold text-navy tracking-[-0.02em]"><%= post.title %></h1>
    <p class="mt-5 text-lg text-slate-700 leading-relaxed"><%= post.excerpt %></p>
    <div class="mt-6 flex items-center gap-3 text-sm text-cool-gray">
      <span><%= post.author %></span>
      <span>·</span>
      <span><%= post.date %></span>
      <span>·</span>
      <span><%= post.readMinutes %> <%= t.resources.labels.readMinutes %></span>
    </div>
  </div>
</section>

<article class="py-16">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="prose-pelxa">
      <% post.body.forEach(function(p){ %>
        <p><%= p %></p>
      <% }); %>
    </div>

    <% if (post.tags && post.tags.length) { %>
      <ul class="mt-10 flex flex-wrap gap-2">
        <% post.tags.forEach(function(tag){ %>
          <li class="px-3 py-1 rounded-full bg-frost text-cool-gray text-xs font-medium">#<%= tag %></li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</article>

<% if (related && related.length) { %>
  <section class="py-16 bg-frost">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-navy tracking-[-0.02em]"><%= t.resources.labels.related %></h2>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        <% related.forEach(function(r){ %>
          <article class="card group">
            <span class="inline-flex w-fit items-center px-2.5 py-1 rounded-md bg-ice-blue text-pelxa-blue text-xs font-semibold uppercase tracking-wide"><%= r.category %></span>
            <h3 class="mt-4 text-lg font-bold text-navy leading-snug group-hover:text-pelxa-blue transition-colors">
              <a href="/<%= locale %>/<%= slugBase %>/<%= r.slug %>"><%= r.title %></a>
            </h3>
            <p class="mt-3 text-sm text-slate-700 leading-relaxed"><%= r.excerpt %></p>
          </article>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>
