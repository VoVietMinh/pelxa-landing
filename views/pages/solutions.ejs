<%- include('../partials/page-hero', { hero: t.solutions.hero }) %>

<!-- PILLAR DETAILS -->
<section class="py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-14">
    <% t.solutions.pillars.forEach(function(p, idx){ %>
      <article class="grid lg:grid-cols-12 gap-10 items-center <%= idx % 2 === 1 ? 'lg:[&>div:first-child]:order-2' : '' %>">
        <div class="lg:col-span-6">
          <div class="w-16 h-16 rounded-2xl bg-ice-blue flex items-center justify-center">
            <img src="/assets/icons/<%= p.icon %>.svg" alt="" class="w-10 h-10" aria-hidden="true" />
          </div>
          <span class="mt-4 inline-flex items-center px-2.5 py-1 rounded-md bg-pelxa-blue/10 text-pelxa-blue text-xs font-semibold uppercase tracking-wide">0<%= idx + 1 %></span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-display font-bold text-navy tracking-[-0.02em]"><%= p.title %></h2>
          <p class="mt-4 text-lg text-slate-700 leading-relaxed"><%= p.description %></p>
          <ul class="mt-6 space-y-3">
            <% p.features.forEach(function(f){ %>
              <li class="flex items-start gap-3 text-slate-700">
                <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-pelxa-blue/10 flex items-center justify-center">
                  <svg class="w-3 h-3 text-pelxa-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span><%= f %></span>
              </li>
            <% }); %>
          </ul>
          <div class="mt-8">
            <a href="<%= t.brand.ctaPrimaryUrl %>" target="_blank" rel="noopener" class="btn-primary text-sm">
              <%= t.brand.ctaPrimary %>
              <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
        <div class="lg:col-span-6">
          <div class="relative">
            <div class="absolute inset-0 bg-future-gradient rounded-[28px] rotate-2 opacity-15 blur-2xl"></div>
            <div class="relative card-feature">
              <div class="grid grid-cols-2 gap-4">
                <% p.features.forEach(function(f, i){ %>
                  <div class="flex items-start gap-2.5 p-4 rounded-xl bg-frost border border-soft-border">
                    <span class="text-xs font-bold text-pelxa-blue">0<%= i+1 %></span>
                    <p class="text-xs text-navy font-medium leading-snug"><%= f %></p>
                  </div>
                <% }); %>
              </div>
              <div class="mt-5 flex items-center justify-between p-4 rounded-xl bg-pelxa-blue/[0.04] border border-pelxa-blue/15">
                <p class="text-sm font-semibold text-navy"><%= p.title %></p>
                <img src="/assets/logo-icon.svg" alt="" class="w-9 h-9 rounded-xl" aria-hidden="true" />
              </div>
            </div>
          </div>
        </div>
      </article>
    <% }); %>
  </div>
</section>

<!-- STACK -->
<section class="py-20 lg:py-24 bg-frost">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="eyebrow"><%= t.solutions.stack.eyebrow %></span>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-navy tracking-[-0.02em]">
        <%= t.solutions.stack.title %>
      </h2>
      <p class="mt-4 text-lg text-slate-700"><%= t.solutions.stack.description %></p>
    </div>
    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% t.solutions.stack.items.forEach(function(item){ %>
        <div class="card-soft">
          <img src="/assets/icons/<%= item.icon %>.svg" alt="" class="w-12 h-12" aria-hidden="true" />
          <h3 class="mt-5 text-lg font-bold text-navy"><%= item.title %></h3>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed"><%= item.description %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('../partials/cta-band', { cta: t.solutions.ctaBand }) %>
