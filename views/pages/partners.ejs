<%- include('../partials/page-hero', { hero: t.partners.hero }) %>

<!-- AUDIENCE -->
<section class="py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-display font-bold text-navy tracking-[-0.02em] max-w-2xl"><%= t.partners.audience.title %></h2>
    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% t.partners.audience.items.forEach(function(item){ %>
        <div class="card">
          <div class="w-14 h-14 rounded-2xl bg-ice-blue flex items-center justify-center">
            <img src="/assets/icons/<%= item.icon %>.svg" alt="" class="w-9 h-9" aria-hidden="true" />
          </div>
          <h3 class="mt-5 text-lg font-bold text-navy"><%= item.title %></h3>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed"><%= item.description %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- BENEFITS -->
<section class="py-20 lg:py-24 bg-frost">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="eyebrow"><%= t.partners.benefits.eyebrow %></span>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-navy tracking-[-0.02em]">
        <%= t.partners.benefits.title %>
      </h2>
    </div>
    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% t.partners.benefits.items.forEach(function(item){ %>
        <div class="card-soft">
          <img src="/assets/icons/<%= item.icon %>.svg" alt="" class="w-12 h-12" aria-hidden="true" />
          <h3 class="mt-5 text-lg font-bold text-navy"><%= item.title %></h3>
          <p class="mt-2 text-sm text-slate-700 leading-relaxed"><%= item.description %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="eyebrow"><%= t.partners.process.eyebrow %></span>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-navy tracking-[-0.02em]"><%= t.partners.process.title %></h2>
    </div>
    <ol class="mt-12 grid md:grid-cols-3 gap-6">
      <% t.partners.process.steps.forEach(function(s){ %>
        <li class="card relative">
          <span class="absolute top-6 right-6 text-5xl font-extrabold text-ice-blue tracking-tight"><%= s.step %></span>
          <h3 class="mt-2 text-xl font-bold text-navy max-w-[80%]"><%= s.title %></h3>
          <p class="mt-3 text-slate-700 leading-relaxed"><%= s.description %></p>
        </li>
      <% }); %>
    </ol>
  </div>
</section>

<%- include('../partials/cta-band', { cta: t.partners.ctaBand }) %>
