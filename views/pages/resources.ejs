<%- include('../partials/page-hero', { hero: t.resources.hero }) %>

<section class="py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <% var slugBase = locale === 'vi' ? 'tai-nguyen' : 'resources'; %>
    <% if (posts.length === 0) { %>
      <p class="text-cool-gray">No posts yet.</p>
    <% } else { %>
      <!-- Featured -->
      <% var featured = posts[0]; %>
      <article class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 relative">
          <div class="absolute inset-0 bg-future-gradient rounded-[28px] rotate-1 opacity-15 blur-2xl"></div>
          <a href="/<%= locale %>/<%= slugBase %>/<%= featured.slug %>" class="relative block aspect-[16/10] rounded-[28px] bg-future-gradient overflow-hidden shadow-pelxa">
            <div class="absolute inset-0 flex flex-col justify-between p-8 text-white">
              <span class="inline-flex w-fit px-3 py-1.5 rounded-full bg-white/15 backdrop-blur text-xs font-semibold uppercase tracking-wide"><%= featured.category %></span>
              <div>
                <h2 class="text-2xl sm:text-3xl font-display font-bold leading-tight"><%= featured.title %></h2>
                <p class="mt-3 text-sm text-white/80 max-w-xl"><%= featured.excerpt %></p>
              </div>
            </div>
          </a>
        </div>
        <div class="lg:col-span-5">
          <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-ice-blue text-pelxa-blue text-xs font-semibold uppercase tracking-wide"><%= featured.category %></span>
          <h2 class="mt-4 text-3xl font-display font-bold text-navy tracking-[-0.02em]"><a class="hover:text-pelxa-blue" href="/<%= locale %>/<%= slugBase %>/<%= featured.slug %>"><%= featured.title %></a></h2>
          <p class="mt-4 text-slate-700 leading-relaxed"><%= featured.excerpt %></p>
          <div class="mt-5 flex items-center gap-3 text-sm text-cool-gray">
            <span><%= featured.author %></span>
            <span>·</span>
            <span><%= featured.date %></span>
            <span>·</span>
            <span><%= featured.readMinutes %> <%= t.resources.labels.readMinutes %></span>
          </div>
          <a href="/<%= locale %>/<%= slugBase %>/<%= featured.slug %>" class="mt-6 inline-flex btn-secondary text-sm">
            <%= t.resources.labels.readMore %>
            <svg class="w-4 h-4 ml-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </article>

      <!-- Grid of remaining posts -->
      <% if (posts.length > 1) { %>
      <div class="mt-16 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% posts.slice(1).forEach(function(p){ %>
          <article class="card group flex flex-col">
            <span class="inline-flex w-fit items-center px-2.5 py-1 rounded-md bg-ice-blue text-pelxa-blue text-xs font-semibold uppercase tracking-wide"><%= p.category %></span>
            <h3 class="mt-4 text-lg font-bold text-navy leading-snug group-hover:text-pelxa-blue transition-colors">
              <a href="/<%= locale %>/<%= slugBase %>/<%= p.slug %>"><%= p.title %></a>
            </h3>
            <p class="mt-3 text-sm text-slate-700 leading-relaxed flex-1"><%= p.excerpt %></p>
            <div class="mt-5 flex items-center gap-3 text-xs text-cool-gray">
              <span><%= p.date %></span>
              <span>·</span>
              <span><%= p.readMinutes %> <%= t.resources.labels.readMinutes %></span>
            </div>
          </article>
        <% }); %>
      </div>
      <% } %>
    <% } %>
  </div>
</section>
