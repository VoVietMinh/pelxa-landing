{
  "name": "pelxa-website",
  "version": "1.0.0",
  "description": "Pelxa — Content, Ads & Traffic Global. Node.js MVC website built with Express + EJS + Tailwind CSS.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build:css": "tailwindcss -i ./public/css/tailwind.src.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./public/css/tailwind.src.css -o ./public/css/tailwind.css --watch"
  },
  "keywords": ["pelxa", "content", "ads", "traffic", "monetization", "saas"],
  "author": "Pelxa",
  "license": "MIT",
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.10",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13"
  }
}
